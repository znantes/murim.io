@page "/"
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
<PageTitle>Murim — Chroniques du Jianghu</PageTitle>
@if (_world?.PlayerNpc is null)
{
    <div class="boot"><div class="brand">☯ MURIM</div><div>Le Jianghu s'éveille…</div></div>
}
else
{
    var p = _world.PlayerNpc;
    var loc = CurrentLocation();
    <header class="topbar"><div><div class="brand">☯ MURIM <span>CHRONIQUES</span></div><div class="subtitle">Une vie. Mille choix. Un Jianghu qui évolue même quand tu ne regardes pas.</div></div><button class="ghost" @onclick="NewLife">Nouvelle vie</button></header>
    <section class="hero-grid">
        <div class="panel profile-card"><div class="avatar">@Initials(p.Identity.DisplayName)</div><div class="profile-main"><div class="eyebrow">DESTIN</div><h1>@p.Identity.DisplayName</h1><div class="muted">@p.AgeYears ans · @p.Profession.Type</div><div class="rank-row"><span class="rank">RANG @Rank</span><span>Réputation @_reputation</span><span>Potentiel @Potential</span></div><div class="xp"><div class="xp-fill" style="width:@XpPercent%"></div></div></div><div class="overall"><b>@Power</b><small>FORCE</small></div></div>
        <div class="panel score-card"><div class="eyebrow">PRÉSAGE DU JOUR</div><h2>@DailyTitle</h2><p>@DailyText</p><button class="gold" @onclick="ResolveDaily">Accomplir le présage</button></div>
    </section>
    <nav class="tabs">@foreach (var tab in _tabs) { <button class="@(tab == _tab ? "active" : "")" @onclick="() => _tab = tab">@tab</button> }</nav>
    <main class="dashboard">
        @if (_tab == "Jianghu")
        {
            <section class="panel section"><div class="section-head"><div><div class="eyebrow">MONDE VIVANT</div><h2>@(loc?.Name ?? "Lieu inconnu")</h2></div><span class="pill">Jour @_world.Time.Day · @_world.Time.Period</span></div><div class="world-stats"><div><b>@_world.Npcs.Values.Count(n => n.IsAlive)</b><span>personnes vivantes</span></div><div><b>@_world.Geography.Locations.Count</b><span>lieux</span></div><div><b>@_world.Commerce.Businesses.Count</b><span>activités</span></div><div><b>@_world.Martial.Techniques.Count</b><span>techniques</span></div></div><h3>Explorer</h3><div class="cards">@foreach (var place in KnownLocations()) { <button class="card" @onclick="() => TravelTo(place.Name)"><b>@place.Name</b><span>@place.Type · danger @place.DangerLevel/100</span></button> }</div><h3>Personnes présentes</h3><div class="cards">@foreach (var npc in PeopleHere()) { <button class="card" @onclick="() => TalkTo(npc.Identity.DisplayName)"><b>@npc.Identity.DisplayName</b><span>@npc.Profession.Type</span></button> }</div></section>
        }
        else if (_tab == "Vie")
        {
            <section class="panel section"><div class="eyebrow">VIE QUOTIDIENNE</div><h2>Forge ton destin</h2><div class="training-grid">@foreach (var action in _lifeActions) { <button class="training" @onclick="() => Act(action.Command)"><b>@action.Icon @action.Title</b><span>@action.Text</span><em>Le temps passe et le monde réagit.</em></button> }</div></section>
        }
        else if (_tab == "Arts martiaux")
        {
            <section class="panel section"><div class="eyebrow">WULIN</div><h2>Arts martiaux</h2><p class="muted">Apprends et perfectionne les techniques du moteur Murim.</p><div class="martial-grid">@foreach (var t in _world.Martial.Techniques.Values.OrderBy(x => x.Name)) { <div class="technique"><b>@t.Name</b><span>Technique du Jianghu</span><button @onclick="() => TrainTechnique(t.Name)">S'entraîner</button></div> }</div></section>
        }
        else if (_tab == "Relations")
        {
            <section class="panel section"><div class="eyebrow">RÉSEAU</div><h2>Alliés, rivaux et mentors</h2><div class="cards">@foreach (var r in p.Relationships.Where(r => r.IsActive && _world.Npcs.TryGetValue(r.ToNpcId, out var n) && n.IsAlive).OrderByDescending(r => r.Trust).Take(40)) { <div class="card"><b>@_world.Npcs[r.ToNpcId].Identity.DisplayName</b><span>@r.Type · confiance @r.Trust.ToString("0.00") · respect @r.Respect.ToString("0.00")</span><button @onclick="() => TalkTo(_world.Npcs[r.ToNpcId].Identity.DisplayName)">Interagir</button></div> }</div></section>
        }
        else if (_tab == "Mémoire")
        {
            <section class="panel section"><div class="eyebrow">CONNAISSANCE</div><h2>Ce que tu sais</h2><div class="stat-list"><div>Santé <b>@p.Body.Health:0</b></div><div>Faim <b>@p.Needs.Hunger:0</b></div><div>Soif <b>@p.Needs.Thirst:0</b></div><div>Sommeil <b>@p.Needs.Sleep:0</b></div><div>Douleur <b>@p.CurrentPain:0</b></div><div>Confiance moyenne <b>@AverageKnowledge():0%</b></div></div><div class="cards">@foreach (var k in p.Knowledge.OrderByDescending(x => x.Confidence).Take(60)) { <div class="card"><b>@k.Summary</b><span>confiance @k.Confidence.ToString("0%") · confirmations @k.ConfirmationCount · jour @k.LastConfirmedDay</span></div> }</div></section>
        }
        else
        {
            <section class="panel section"><div class="eyebrow">CHRONIQUE</div><h2>Journal vivant</h2><div class="stat-list"><div>Jour <b>@_world.Time.Day</b></div><div>Période <b>@_world.Time.Period</b></div><div>Réputation <b>@_reputation</b></div><div>Force <b>@Power</b></div><div>Renommée <b>@Fame</b></div></div><div class="log">@foreach (var line in _log) { <div class="@line.Css">@line.Text</div> }</div></section>
        }
    </main>
    <aside class="command-bar panel"><div class="quick">@foreach (var q in _quick) { <button @onclick="() => Act(q.Command)">@q.Icon @q.Label</button> }</div><div class="command"><input @bind="_command" @bind:event="oninput" @onkeydown="HandleKey" placeholder="observe · parle à... · va à... · enquête · détecte les dangers · dors" /><button class="gold" @onclick="Send">Agir</button></div></aside>
}
@code {
    private WorldState? _world;
    private readonly PlayerCommandService _commands = new();
    private readonly List<(string Text,string Css)> _log = [];
    private string _command = "";
    private string _tab = "Jianghu";
    private int _reputation = 10;
    private readonly string[] _tabs = ["Jianghu","Vie","Arts martiaux","Relations","Mémoire","Chronique"];
    private readonly List<(string Icon,string Label,string Command)> _quick = [("👁","Observer","observe"),("🔎","Enquête","enquête"),("⚠","Danger","détecte les dangers"),("💼","Travail","cherche du travail"),("🌙","Dormir","dors"),("📜","Profil","inspecte ton profil")];
    private readonly List<(string Icon,string Title,string Text,string Command)> _lifeActions = [("🌿","Cultiver","Travaille ton corps et ton souffle.","travaille"),("📚","Étudier","Cherche du savoir et de nouvelles informations.","étudie"),("🛡","Patrouiller","Aide les habitants et gagne leur confiance.","patrouille"),("🧘","Méditer","Récupère et affine ton esprit.","médite"),("🛏","Repos","Récupère après les épreuves.","dors")];
    private int Potential => Math.Clamp(70 + _reputation / 3,70,99);
    private int Power => Math.Clamp(25 + _reputation * 2,1,99);
    private int Fame => Math.Max(0,_reputation * 31);
    private int XpPercent => Math.Clamp((_reputation * 7) % 100,5,96);
    private string Rank => _reputation >= 80 ? "GRAND MAÎTRE" : _reputation >= 55 ? "MAÎTRE" : _reputation >= 30 ? "INITIÉ" : "ERRANT";
    private string DailyTitle => _reputation < 30 ? "Trouver ta première piste" : _reputation < 60 ? "Un nom circule dans le Jianghu" : "Le Jianghu te reconnaît";
    private string DailyText => _reputation < 30 ? "Observe le monde, parle aux habitants et découvre une vérité utile." : "Ta réputation attire désormais des alliés, des rivaux et des opportunités.";
    protected override void OnInitialized() => NewLife();
    private void NewLife() { _world=new WorldState(); _world.CreatePlayerAtBirth(20260908,"Murim"); _reputation=10; _log.Clear(); AddLog("Ta vie commence. Le Jianghu n'attend pas.",true); }
    private Location? CurrentLocation() => _world?.PlayerNpc?.CurrentLocationId is Guid id && _world.Geography.Locations.TryGetValue(id,out var location) ? location : null;
    private IEnumerable<Location> KnownLocations() => _world!.PlayerNpc!.KnownLocationIds.Where(id=>_world.Geography.Locations.ContainsKey(id)).Select(id=>_world.Geography.Locations[id]).OrderBy(x=>x.Name);
    private IEnumerable<Npc> PeopleHere() => _world!.Npcs.Values.Where(n=>n.IsAlive && n.CurrentLocationId==_world.PlayerNpc!.CurrentLocationId && n.Identity.DisplayName!=_world.PlayerNpc.Identity.DisplayName).Take(30);
    private void TravelTo(string name)=>Act($"va à {name}");
    private void TrainTechnique(string name)=>Act($"entraine toi avec {name}");
    private void TalkTo(string name)=>Act($"parle à {name}");
    private void ResolveDaily(){Act(_reputation<30?"enquête":"observe");_reputation=Math.Min(99,_reputation+2);AddLog("Le présage est accompli : ta réputation grandit.",true);}
    private void Act(string command){if(_world is null)return;var result=_commands.Execute(_world,command);AddLog(result.Feedback,result.Success);if(result.Success)_reputation=Math.Min(99,_reputation+1);if(result.MinutesSpent>0)AddLog($"Temps écoulé : {result.MinutesSpent} min.",true);StateHasChanged();}
    private void Send(){var c=_command.Trim();_command="";if(c.Length>0)Act(c);}
    private void HandleKey(KeyboardEventArgs e){if(e.Key=="Enter")Send();}
    private double AverageKnowledge()=>_world?.PlayerNpc?.Knowledge.Count>0?_world.PlayerNpc.Knowledge.Average(k=>k.Confidence)*100:0;
    private static string Initials(string name)=>string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>x[0])).ToUpperInvariant();
    private void AddLog(string text,bool success){_log.Insert(0,(text,success?"good":"bad"));if(_log.Count>80)_log.RemoveAt(_log.Count-1);}
    public void Dispose(){}
}
