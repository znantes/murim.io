{
  "version": 1,
  "external": true,
  "root": "assets/portraits",
  "format": "webp",
  "identity_count_target": 10000,
  "age_variants": [0,5,12,18,30,45,65],
  "states": ["healthy","injured","scarred","elderly","disguised"],
  "fallback": "assets/portraits/fallback.svg",
  "naming": "P{identity:000000}/age_{age:00}_{state}.webp",
  "rules": {
    "persistent_identity": true,
    "age_progression": true,
    "state_progression": true,
    "never_randomize_existing_identity": true,
    "load_on_demand": true,
    "missing_asset_is_nonfatal": true
  }
}
